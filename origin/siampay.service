[Unit]
Description=SiamPay Request Inspector (origin)
After=network.target

[Service]
User=siampay
ExecStart=/usr/bin/node /opt/siampay/server.js
Environment=HOST=127.0.0.1 PORT=8080 ORIGIN_PUBLIC_IP=46.137.224.57
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
